{
  "name": "dsh-filmcraft-progress",
  "version": "0.2.5",
  "description": "FilmCraft 瑙嗛鍓緫/璋冭壊杩涘害闈㈡澘 + 鍩虹鍓緫 for DeepSeek Harness",
  "type": "module",
  "main": "./dist/native/index.js",
  "exports": {
    ".": "./dist/native/index.js",
    "./client": "./dist/native/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/**",
    "src/**",
    "tools/**",
    "scripts/**",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-native.mjs"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "cordis",
    "plugin",
    "filmcraft",
    "artcraft",
    "video",
    "editing",
    "progress",
    "dashboard"
  ],
  "license": "MIT",
  "author": "dkvkvk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkvkvk/dsh-filmcraft-progress.git"
  },
  "bugs": {
    "url": "https://github.com/dkvkvk/dsh-filmcraft-progress/issues"
  },
  "homepage": "https://github.com/dkvkvk/dsh-filmcraft-progress#readme"
}
